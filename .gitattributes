# 默认：文本按平台检出，提交时统一 LF
* text=auto

# Windows 批处理必须是 CRLF（cmd.exe 对 LF 的 .bat 兼容性差）
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Shell 脚本必须是 LF（CRLF 会导致 bash 报 bad interpreter）
*.sh   text eol=lf

# 其余文本统一 LF，保证跨平台一致
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# 二进制
*.glb   binary
*.dds   binary
*.blend binary
*.png   binary
*.jpg   binary
*.rar   binary
*.fpk   binary
*.fpkd  binary
*.ftex  binary
*.fmdl  binary
